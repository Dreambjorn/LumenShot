#include <windows.h>
#include "resource_ids.h"

HDRSHOT_NOTICES_RESOURCE RCDATA "@HDRSHOT_NOTICES_FILE@"

HDRSHOT_LICENSE_DIALOG DIALOGEX 0, 0, 440, 304
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Licenses - LumenShot"
FONT 10, "Segoe UI"
BEGIN
    EDITTEXT HDRSHOT_LICENSE_TEXT, 10, 10, 420, 258, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Close", IDCANCEL, 360, 278, 70, 18
END
