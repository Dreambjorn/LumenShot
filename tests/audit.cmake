# Static release checks: system-only imports, no process or input-injection APIs, asInvoker manifest, PE hardening.
execute_process(COMMAND "${OBJDUMP}" -p "${EXECUTABLE}" OUTPUT_VARIABLE dump RESULT_VARIABLE failed)
if(failed)
    message(FATAL_ERROR "Cannot inspect the executable's imports.")
endif()

string(REGEX MATCHALL "DLL Name: [^\r\n]+" imports "${dump}")
if(NOT imports)
    message(FATAL_ERROR "No imports found.")
endif()
foreach(entry IN LISTS imports)
    string(REPLACE "DLL Name: " "" dll "${entry}")
    string(TOLOWER "${dll}" dll)
    if(NOT dll MATCHES "^(advapi32|dwmapi|uxtheme|comctl32|comdlg32|d3d11|dxgi|gdi32|kernel32|ole32|shell32|user32)\\.dll$"
       AND NOT dll MATCHES "^api-ms-win-(crt|core)-.+\\.dll$")
        message(FATAL_ERROR "Unexpected runtime import: ${dll}")
    endif()
endforeach()

set(forbidden "ReadProcessMemory|WriteProcessMemory|CreateRemoteThread|VirtualAllocEx|SetWindowsHookEx|DebugActiveProcess|SendInput|DeviceIoControl|DisplayConfigSetDeviceInfo|ChangeDisplaySettings|WinHttpOpen|InternetOpen|CreateProcess")
if(dump MATCHES "${forbidden}")
    message(FATAL_ERROR "Executable imports a forbidden API: ${CMAKE_MATCH_0}")
endif()
# OpenProcess is imported by the static winpthreads runtime, so only the sources are checked for it.
file(GLOB sources "${SOURCE_DIR}/*.cpp" "${SOURCE_DIR}/*.hpp" "${SOURCE_DIR}/*.rc" "${SOURCE_DIR}/*.manifest")
foreach(source IN LISTS sources)
    file(READ "${source}" text)
    if(text MATCHES "OpenProcess|${forbidden}")
        message(FATAL_ERROR "${source} uses a forbidden API: ${CMAKE_MATCH_0}")
    endif()
endforeach()

file(STRINGS "${EXECUTABLE}" invoker REGEX "level=\"asInvoker\"")
if(NOT invoker)
    message(FATAL_ERROR "asInvoker manifest is missing from the executable.")
endif()
foreach(flag HIGH_ENTROPY_VA DYNAMIC_BASE NX_COMPAT)
    if(NOT dump MATCHES "${flag}")
        message(FATAL_ERROR "Missing PE protection flag: ${flag}")
    endif()
endforeach()
execute_process(COMMAND "${EXECUTABLE}" --licenses OUTPUT_VARIABLE notices
    RESULT_VARIABLE notices_failed ENCODING UTF-8 TIMEOUT 10)
if(notices_failed)
    message(FATAL_ERROR "Cannot read the executable's embedded notices: ${notices_failed}")
endif()
string(REPLACE "\r\n" "\n" notices "${notices}")
get_filename_component(root "${SOURCE_DIR}" DIRECTORY)
file(GLOB license_files "${root}/LICENSE" "${root}/THIRD_PARTY_NOTICES.md" "${root}/licenses/*")
foreach(path IN LISTS license_files)
    file(READ "${path}" required_notice)
    string(REPLACE "\r\n" "\n" required_notice "${required_notice}")
    string(FIND "${notices}" "${required_notice}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Executable does not retain the complete notice: ${path}")
    endif()
endforeach()
list(LENGTH license_files notice_count)
message(STATUS "Embedded notices passed: ${notice_count} complete source and dependency texts.")
list(LENGTH imports count)
message(STATUS "Audit passed: ${count} system imports, no forbidden APIs, asInvoker, ASLR and DEP.")
